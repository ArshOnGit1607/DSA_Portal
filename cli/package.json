{
  "name": "dsa-practice-cli",
  "version": "1.0.0",
  "description": "Practise data structures and algorithms in your terminal: pick a topic and difficulty, solve in JavaScript, get instant test results, hints and solutions.",
  "keywords": [
    "dsa",
    "algorithms",
    "data-structures",
    "practice",
    "interview",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipu01-code/DSA_Portal.git",
    "directory": "cli"
  },
  "bin": {
    "dsa": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/sandbox-exec.js",
    "problems"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@dsa-portal/core": "*",
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.0"
  }
}
