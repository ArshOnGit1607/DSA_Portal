{
  "name": "dsa-portal",
  "private": true,
  "version": "0.0.1",
  "description": "DSA Practice Platform monorepo (CLI, Web, Desktop, Mobile)",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "core",
    "server",
    "workers",
    "web",
    "desktop",
    "mobile",
    "ui-core",
    "docs",
    "infra",
    "scripts"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm run dev -w server",
    "test:core": "npm run test -w core",
    "lint": "eslint . --ext .ts,.js --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .ts,.js --ignore-path .gitignore --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "build": "npm run build -w core -w server -w workers"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
