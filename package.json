{
  "name": "dsa-portal",
  "private": true,
  "version": "0.0.1",
  "description": "DSA Practice Platform monorepo (CLI, Web, Desktop, Mobile)",
  "engines": { "node": "20.x" },
  "workspaces": ["core", "server", "workers", "web", "desktop", "mobile", "ui-core", "docs", "infra", "scripts"],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm run dev -w server",
    "test:core": "npm run test -w core",
    "build": "npm run build -w core -w server -w workers"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
