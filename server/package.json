{
  "name": "@dsa-portal/server",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dev:token": "node -e \"const s=require('fast-jwt').createSigner({key:process.env.JWT_SECRET||'dev-secret-change-me',expiresIn:3600000});console.log(s({sub:process.argv[1]||'00000000-0000-0000-0000-000000000002'}))\"",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:down": "tsx src/db/migrate.ts down",
    "db:reset": "tsx src/db/migrate.ts reset && tsx src/db/seed.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:import-legacy": "tsx src/db/import-legacy.ts"
  },
  "dependencies": {
    "@dsa-portal/core": "*",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.26.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "yaml": "^2.9.1"
  }
}
