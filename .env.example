PORT=3000
JWT_SECRET=change-me-in-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dsa_portal
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# Worker (Day 5): parallel judging loops per process, and poll fallback if a NOTIFY is missed
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
# Worker reliability (Day 6, see docs/queue-design.md)
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_MS=1000
WORKER_LEASE_MS=30000
# Prometheus scrape port for GET /metrics; leave empty to disable
WORKER_METRICS_PORT=9464
# API backpressure: 429 + Retry-After once this many submissions are waiting
QUEUE_MAX_WAITING=500
QUEUE_RETRY_AFTER_S=10
# Only for the end-to-end queue test (npx jest workers); must be a separate, migrated database
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/dsa_portal_test
