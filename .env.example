PORT=3000
JWT_SECRET=change-me-in-production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dsa_portal
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# Worker (Day 5): parallel judging loops per process, and poll fallback if a NOTIFY is missed
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
